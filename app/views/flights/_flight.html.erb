<h4><%= flight.source_port.city %> to <%= flight.dest_port.city %></h4>
<p><span class="flight-key">Source: </span><%= flight.source_port.city %> in <%= flight.source_port.country%></p>
<p><span class="flight-key">Source Airport: </span><%= flight.source_port.name %></p>
<p><span class="flight-key">Destination: </span><%= flight.dest_port.city %> in <%= flight.dest_port.country %></p>
<p><span class="flight-key">Destination Airport: </span><%= flight.dest_port.name %></p>
<p><span class="flight-key">Departs: </span><%= flight.departure_time %></p>
<p><span class="flight-key">Arrives: </span><%= flight.arrival_time %></p>
<p><span class="flight-key">Expected Duration: </span><%= (flight.duration_minutes).fdiv(60).round(2) %>hr</p>
<p><span class="flight-key">Duration: </span><%= (flight.duration_minutes + flight.delay_time_minutes).fdiv(60).round(2) %>hr</p>
<p><span class="flight-key">Delay Time Minutes: </span><%= flight.delay_time_minutes %>min</p>

<div class="booking-div">
  <% if @logged_in %>
    <% if @users_flights.include?(flight) %>
      <%= button_to "Unbook", '/booking', method: "delete", controller: "bookings", action: "destroy", params: { flight_id: flight.id } %>
    <% else%>
      <%= button_to "Book", method: "post", controller: "bookings", action: "create", params: { flight_id: flight.id } %>
    <% end %>
  <% end %>

  <% if params[:action] == 'index' %>
    <%= link_to "Show", flight_path(flight.id) %>
  <% end %>
</div>

<br>

