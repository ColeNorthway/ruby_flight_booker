<%= form_with model: @passenger, url: passenger_path, method: @passenger.new_record? ? :post : :patch do |form| %>
  Username: <%= form.text_field :username %><br>
  Email: <%= form.email_field :username %><br>
  Password: <%= form.password_field :password %><br>
  Password: <%= form.password_field :password_confirmation %><br>
  <%= form.fields_for :passenger_profile do |profile_form| %>
    First Name: <%= profile_form.text_field :first_name%><br>
    Last Name: <%= profile_form.text_field :last_name%><br>
    Gender: <%= profile_form.radio_button :gender, "true", required: true%> <%# male %>
      <%= profile_form.radio_button :gender, "false", required: false%><br> <%# female %>
    Date of Birth: <%= profile_form.date_field :dob%><br>
    Password: <%= profile_form.password_field :ssn%><br><br>
  <% end %>
<% end %>