<%= render partial: 'error', locals: { obj: @passenger } %>

<%= form_with model: @passenger, url: '/change_password', method: 'put' do |form| %>
  Current Password: <%= form.password_field :password_challenge %><br>
  New Password: <%= form.password_field :password %><br>
  Confirm Password: <%= form.password_field :password_confirmation %><br>
  <%= form.submit "Change Password" %><br><br>
<% end %>

<%= render partial: 'footer' %>